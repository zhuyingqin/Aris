#!/usr/bin/env sh
set -eu

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(dirname "$DIR")
NODE="$ROOT/node/node"
SCRIPT="$ROOT/mcp/playwright/node_modules/@playwright/mcp/cli.js"
VERSION="0.0.76"

HAS_CDP=0
for arg in "$@"; do
  [ "$arg" = "--cdp-endpoint" ] && HAS_CDP=1
done
if [ "$HAS_CDP" -eq 0 ] && [ -z "${PLAYWRIGHT_MCP_USER_DATA_DIR:-}" ]; then
  PLAYWRIGHT_MCP_USER_DATA_DIR=".somniq/tmp/browser/profile"
  export PLAYWRIGHT_MCP_USER_DATA_DIR
fi
if [ -z "${PLAYWRIGHT_MCP_OUTPUT_DIR:-}" ]; then
  PLAYWRIGHT_MCP_OUTPUT_DIR=".somniq/tmp/browser/output"
  export PLAYWRIGHT_MCP_OUTPUT_DIR
fi
[ -z "${PLAYWRIGHT_MCP_USER_DATA_DIR:-}" ] || mkdir -p "$PLAYWRIGHT_MCP_USER_DATA_DIR" 2>/dev/null || true
mkdir -p "$PLAYWRIGHT_MCP_OUTPUT_DIR" 2>/dev/null || true

if [ -f "$SCRIPT" ]; then
  if [ -x "$NODE" ]; then
    exec "$NODE" "$SCRIPT" "$@"
  fi
  if command -v node >/dev/null 2>&1; then
    exec node "$SCRIPT" "$@"
  fi
fi

if command -v npx >/dev/null 2>&1; then
  exec npx -y "@playwright/mcp@$VERSION" "$@"
fi

echo "ARIS Playwright MCP runtime is missing. Rebuild the desktop bundle with 'npm run build:resources', or install Node.js/npm and retry." >&2
exit 1
