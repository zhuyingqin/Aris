#!/usr/bin/env sh
set -eu

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SELF="$DIR/latexmk"

find_real_latexmk() {
  OLD_IFS=$IFS
  IFS=:
  for dir in $PATH; do
    [ -n "$dir" ] || dir=.
    for name in latexmk latexmk.exe latexmk.cmd latexmk.bat; do
      candidate="$dir/$name"
      if [ -f "$candidate" ] && [ "$candidate" != "$SELF" ]; then
        case "$candidate" in
          "$DIR/"*) ;;
          *) printf '%s\n' "$candidate"; IFS=$OLD_IFS; return 0 ;;
        esac
      fi
    done
  done
  IFS=$OLD_IFS
  return 1
}

if real=$(find_real_latexmk); then
  exec "$real" "$@"
fi

clean=false
entry=""
for arg in "$@"; do
  [ "$arg" = "-C" ] && clean=true
  case "$arg" in
    *.tex) entry=$arg ;;
  esac
done

if [ "$clean" = true ]; then
  rm -f ./*.aux ./*.bbl ./*.bcf ./*.blg ./*.fdb_latexmk ./*.fls ./*.log ./*.out ./*.run.xml ./*.synctex.gz ./*.toc 2>/dev/null || true
  exit 0
fi

if [ -z "$entry" ]; then
  if [ -f main.tex ]; then
    entry=main.tex
  else
    set -- ./*.tex
    [ -f "$1" ] && entry=$1
  fi
fi

if [ -z "$entry" ]; then
  echo "latexmk fallback could not find a .tex entrypoint." >&2
  exit 2
fi

TECTONIC_BIN=${ARIS_TECTONIC:-}
if [ -z "$TECTONIC_BIN" ]; then
  if [ -f "$DIR/tectonic.exe" ]; then
    TECTONIC_BIN="$DIR/tectonic.exe"
  else
    TECTONIC_BIN="$DIR/tectonic"
  fi
fi
if [ ! -f "$TECTONIC_BIN" ]; then
  echo "latexmk fallback requires tectonic in resources/bin or ARIS_TECTONIC." >&2
  exit 127
fi

exec "$TECTONIC_BIN" --keep-logs --keep-intermediates "$entry"
