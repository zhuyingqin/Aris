{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SomniQ Studio",
  "version": "0.4.47",
  "identifier": "com.aris.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:resources && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SomniQ Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/**/*"],
    "publisher": "SomniQ",
    "category": "DeveloperTool",
    "shortDescription": "Local-first research workspace with chat, lab, literature, mail, typeset, and scheduled tasks.",
    "longDescription": "SomniQ Studio — local-first desktop workspace for chat with the executor, browsing skills/sessions, running lab experiments, reading literature, and writing LaTeX documents."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwOEQ3OUM5MEMxQzlDREQKUldUZG5Cd015WG1OMEZSOElveUJhbVV0ZUFCQy9BdGZITm81TWQ5dXlzMnM1NTlzTkw2Yk5rWUEK",
      "endpoints": [
        "https://github.com/zhuyingqin/Aris/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
