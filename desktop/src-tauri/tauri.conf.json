{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARIS Studio",
  "version": "0.1.1",
  "identifier": "com.aris.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run build:cli"
  },
  "app": {
    "windows": [
      {
        "title": "ARIS Studio — Team & Workflow",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/bin/*": "bin/"
    },
    "publisher": "ARIS",
    "category": "DeveloperTool",
    "shortDescription": "Design & monitor agent teams and workflows; chat with ARIS.",
    "longDescription": "ARIS Studio — desktop UI for designing agent-team workflows, monitoring runs live, browsing skills/sessions, and chatting with the ARIS executor."
  }
}
