{
  "name": "aris-studio",
  "private": true,
  "version": "0.4.56",
  "type": "module",
  "description": "SomniQ Studio - desktop UI for Chat, literature, skills, sessions, and settings",
  "scripts": {
    "dev": "vite",
    "dev:typeset": "vite --host 127.0.0.1 --port 1420 --strictPort --open /?typesetPreview=1",
    "build": "vite build",
    "build:playwright-mcp": "node scripts/build-playwright-mcp-resource.cjs",
    "build:tectonic": "node scripts/build-tectonic-resource.cjs",
    "build:vscodium": "node scripts/build-vscodium-resource.cjs",
    "analyze:longmemeval-paired": "node scripts/analyze-longmemeval-paired.cjs",
    "analyze:longmemeval-builtin": "node scripts/analyze-longmemeval-builtin.cjs",
    "analyze:longmemeval-research-layers": "node scripts/analyze-longmemeval-research-layers.cjs",
    "build:resources": "npm run build:playwright-mcp && npm run build:tectonic && npm run build:vscodium",
    "build:internal": "node scripts/build-internal-installer.cjs",
    "generate:updater-json": "node scripts/generate-updater-json.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@tanstack/react-virtual": "^3.14.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "highlight.js": "^11.11.1",
    "jsonrepair": "^3.15.0",
    "katex": "^0.17.0",
    "mathlive": "^0.110.0",
    "mermaid": "^11.15.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
