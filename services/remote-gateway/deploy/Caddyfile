{
	# Caddy uses this solely for ACME account and certificate notifications.
	email {$CADDY_EMAIL}
	# The admin API is unnecessary for this single-purpose deployment.
	admin off
}

# Caddy automatically obtains TLS certificates, redirects HTTP to HTTPS, and
# preserves WebSocket upgrades for every /v1 route. Do not add an access-log
# block here: bearer credentials and the browser's one-time
# Sec-WebSocket-Protocol ticket must never become log fields.
{$SOMNIQ_GATEWAY_DOMAIN} {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# The PWA keeps its paired-device credential in IndexedDB, so do not
		# permit injected scripts, plugins, or cross-origin framing. Vite emits
		# external hashed modules and the app needs only this origin plus the
		# paired gateway's WSS endpoints.
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https: wss:; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"
	}

	# WebSocket upgrades and normal X-Forwarded-* headers are handled by Caddy.
	# Keep the PWA on the same HTTPS origin so no broad CORS policy is necessary.
	@api path /healthz /v1/*
	handle @api {
		handle {
			reverse_proxy gateway:8787
		}
	}

	# The install shell and worker must always be revalidated. Hashed Vite
	# bundles are immutable, so they can remain fast without pinning a phone to
	# an earlier UI release.
	@pwa_shell path / /index.html /pair /sw.js /manifest.webmanifest /refresh.html /refresh-v12.html /pwa-recover-v13.html
	header @pwa_shell {
		Cache-Control "no-store, max-age=0, must-revalidate"
		Pragma "no-cache"
	}
	@pwa_assets path /assets/*
	header @pwa_assets Cache-Control "public, max-age=31536000, immutable"

	# Browser-installable mobile PWA. Build ../remote-mobile/dist before
	# starting Compose; unknown client-side routes fall back to index.html.
	handle {
		root * /srv/mobile
		try_files {path} /index.html
		file_server
	}
}
