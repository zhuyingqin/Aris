# Replace every <...> placeholder before enabling this vhost. This file is
# included from Nginx's `http { ... }` context after 00-somniq-http-context.
#
# This is a two-stage edge: the first server redirects clear-text HTTP and the
# second owns TLS and proxies to the internal Caddy container. Do not point
# proxy_pass at the raw gateway.

server {
    listen 80;
    listen [::]:80;
    server_name <somniq.example.com>;

    # Keep HTTP-01 reachable even after the normal site moves to HTTPS. The
    # outer Nginx Compose override mounts this persistent host directory at
    # the same path inside the container.
    location ^~ /.well-known/acme-challenge/ {
        root /opt/somniq-remote/acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name <somniq.example.com>;

    ssl_certificate     <path-to-fullchain.pem>;
    ssl_certificate_key <path-to-privkey.pem>;
    ssl_protocols TLSv1.2 TLSv1.3;

    # The PWA is same-origin with the gateway. Avoid request/access logging at
    # this vhost: credentials, bearer tokens, and WS tickets are sensitive.
    access_log off;
    client_max_body_size 256k;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https: wss:; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests" always;

    # Limit only the public, first-use registration write path. Existing
    # desktops use the same route with a bearer, and the burst leaves normal
    # user retries unaffected.
    location = /v1/pairings {
        limit_req zone=somniq_pairing_registration burst=8 nodelay;
        proxy_pass http://somniq_remote_edge;
        include <path-to-proxy-headers.conf>;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location / {
        proxy_pass http://somniq_remote_edge;
        include <path-to-proxy-headers.conf>;

        # Do not buffer or time out the authenticated WebSocket paths.
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
