# Public DNS name pointing at this server. Caddy obtains and renews a
# certificate for it. For a raw IP deployment, use the separately documented
# existing-Nginx/IP-certificate path rather than setting this to an IP literal.
SOMNIQ_GATEWAY_DOMAIN=gateway.example.com
CADDY_EMAIL=ops@example.com

# Generate a unique 32-byte (or longer) value for every deployment, for
# example: openssl rand -hex 32
# Never commit the resulting .env file or paste this secret into logs/tickets.
SOMNIQ_GATEWAY_BOOTSTRAP_TOKEN=REPLACE_WITH_A_64_HEX_CHARACTER_SECRET

# Safe P0/P1 defaults. Keep the activation completion window short.
SOMNIQ_GATEWAY_PAIRING_TTL_SECS=300
SOMNIQ_GATEWAY_ACTIVATION_COMPLETION_TTL_SECS=60
# Browser/PWA WebSocket tickets are one-time and must stay short-lived. They
# travel only in Sec-WebSocket-Protocol, never in a URL or query string.
SOMNIQ_GATEWAY_BROWSER_WS_TICKET_TTL_SECS=60
SOMNIQ_GATEWAY_MAX_WS_BYTES=262144
# Server-side backstops for login-free first-use pairing. The supplied Nginx
# templates also limit POST /v1/pairings by client address.
SOMNIQ_GATEWAY_MAX_PENDING_PAIRINGS=64
SOMNIQ_GATEWAY_MAX_UNPAIRED_DESKTOPS=128

# Optional for local, non-Docker runs. It must be an absolute private
# directory. The supplied Docker Compose deployments set this internally to
# their named `gateway_state` volume, so do not override it there.
# SOMNIQ_GATEWAY_STATE_DIR=/var/lib/somniq

# Do not use debug logging in a public deployment. In particular, do not add
# middleware or proxy logging that captures Authorization headers or bodies.
RUST_LOG=somniq_remote_gateway=info
