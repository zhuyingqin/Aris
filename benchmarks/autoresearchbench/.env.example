# Optional overrides. If these are omitted, the runner reads the active
# executor from ~/.config/SomniQ/config.json.
SOMNIQ_BENCH_PROVIDER=openai
SOMNIQ_BENCH_MODEL=
SOMNIQ_BENCH_API_BASE=
SOMNIQ_BENCH_API_KEY=
# auto, chat, or responses; use chat for OpenAI-compatible gateways that
# cannot convert Responses tool-call messages correctly.
SOMNIQ_BENCH_TRANSPORT=auto
# Enable only for gateways whose streaming tool responses omit required
# reasoning_content; this uses the same OpenAI tool protocol non-streaming.
SOMNIQ_BENCH_NON_STREAM=0
# Add top-level ids to assistant/tool messages for strict custom gateways.
SOMNIQ_BENCH_MESSAGE_IDS=0

# Optional independent Reviewer. The --reviewer flag also requires the
# Reviewer to be enabled/configured in SomniQ unless these values are supplied.
SOMNIQ_BENCH_REVIEWER_PROVIDER=
SOMNIQ_BENCH_REVIEWER_MODEL=
SOMNIQ_BENCH_REVIEWER_API_BASE=
SOMNIQ_BENCH_REVIEWER_API_KEY=

# Optional search-provider credentials. OpenAlex, Crossref and arXiv do not
# require keys; these improve coverage when available.
SCOPUS_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
