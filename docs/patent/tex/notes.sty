% =====================================================================
%  notes.sty —— 内部工作文档版式（检索记录 / 发明构建书 / 递交注意事项）
%
%  这些不是递交件，不受 CNIPA 形式要求约束，所以版心更宽、可以用表格、
%  可以有页眉。递交件请用 cnipa.sty。
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notes}[2026/09/15 patent working-notes layout]

\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{enumitem}
\RequirePackage{amssymb}
\RequirePackage{xcolor}
\RequirePackage{symbols}
\RequirePackage[hidelinks]{hyperref}

\geometry{a4paper, left=22mm, right=18mm, top=22mm, bottom=20mm, footskip=10mm}

\setCJKmainfont{SimSun}
\newCJKfontfamily\ntbf{SimHei}
\linespread{1.3}\selectfont
\setlength{\parindent}{0pt}
\setlength{\parskip}{2.6mm}

% ---------- 页眉页脚 ----------
\newcommand{\notestitle}[1]{\gdef\@notestitle{#1}}
\notestitle{}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\ntbf\@notestitle}
\fancyhead[R]{\footnotesize 一种大语言模型智能体的工具调用控制方法及系统}
\fancyfoot[C]{\footnotesize 第 \thepage{} 页 / 共 \pageref{LastPage} 页}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\RequirePackage{lastpage}

% ---------- 标题层级 ----------
\newcommand{\nH}[1]{%
  \par\vspace{1mm}{\ntbf\zihao{3}#1}\par
  \vspace{-2mm}\rule{\linewidth}{0.8pt}\par\vspace{1mm}}
\newcommand{\nHH}[1]{\par\vspace{4mm}{\ntbf\zihao{4}#1}\par\vspace{0.5mm}\nopagebreak}
\newcommand{\nHHH}[1]{\par\vspace{2.5mm}{\ntbf\zihao{-4}#1}\par\vspace{0.3mm}\nopagebreak}

% ---------- 表格 ----------
% 等宽 p 列，宽度按列数取 \linewidth 的固定比例，留出列间距。
\newcolumntype{Y}[1]{>{\raggedright\arraybackslash}p{#1\linewidth}}
\newenvironment{ntable}[1]
  {\par\small\renewcommand{\arraystretch}{1.18}\begin{longtable}{#1}\toprule}
  {\bottomrule\end{longtable}\par}
\newcommand{\nthead}{\midrule\endhead}

% ---------- 列表 ----------
\setlist[itemize]{leftmargin=1.6em, itemsep=0.4mm, topsep=1mm, parsep=0pt}
\setlist[enumerate]{leftmargin=2.0em, itemsep=0.4mm, topsep=1mm, parsep=0pt}
% 核查清单的方框
\newcommand{\nbox}{$\square$}

% ---------- 引文块 ----------
\newenvironment{nquote}
  {\par\begin{list}{}{\leftmargin=1.2em\rightmargin=0pt}\item[]\itshape\small
   \color{black!75}}
  {\end{list}\par}

% ---------- 行内代码 ----------
\RequirePackage{fvextra}
\newcommand{\nc}[1]{\texttt{\small #1}}

\endinput
