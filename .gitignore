# Personal paper workspace (NOT project code — outside the paper-write skill)
papers/
main.tex
*.log

# Local scratch benchmarks
_bench*.mjs
desktop/.benchmark-cache/
desktop/.benchmark-results/

# pnpm local cache (mirrors pnpm install, never tracked)
.pnpm-store/

# Local release/deployment staging and diagnostic output
.codex-deploy-stage/
desktop-build.log
desktop-lib-test*.log
prompt-determinism-test.log
remote-single-test*.log
somniq-remote*.tar.gz

# Local scratch worktrees, profiles and binary backups. These are created by
# hand during releases and debugging; keeping them unignored once put a 2.3 GB
# checkout one `git add -A` away from the history.
.tmp-*

# Release artifact extractions used for build verification. These can be
# hundreds of MB each and are created by hand when sanity-checking the
# uploaded installer.
site/temp_release_*/
