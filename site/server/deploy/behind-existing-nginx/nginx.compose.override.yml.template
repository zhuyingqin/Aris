# Copy this file into the *existing Nginx Compose project*, rename `nginx` if
# necessary, and use it as a second Compose file. It makes the private
# network attachment and ACME/certificate storage survive Nginx recreation.
#
# The host directories are intentionally persistent; do not use anonymous
# volumes for certificate state or HTTP-01 webroot files.
services:
  nginx:
    networks:
      # The existing edge must keep its project-default network too: it uses
      # that network to reach the pre-existing application upstreams.
      default: {}
      somniq_nginx_edge:
    volumes:
      # Nginx only reads both paths. The certificate renewal process gets the
      # same paths read/write, as shown in README.md.
      - /opt/somniq-remote/acme:/opt/somniq-remote/acme:ro
      - /opt/somniq-remote/certificates:/etc/letsencrypt:ro
      # The main Nginx configuration includes these small SomniQ fragments
      # from its http context. Keeping them separate avoids replacing the
      # existing application's complete Nginx configuration.
      - /opt/somniq-remote/nginx:/etc/nginx/somniq:ro

networks:
  somniq_nginx_edge:
    external: true
    name: ${SOMNIQ_NGINX_EDGE_NETWORK:-somniq-nginx-edge}
