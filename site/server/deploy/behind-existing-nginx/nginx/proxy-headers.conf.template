# Include from each SomniQ proxy location after replacing the placeholder in
# 20-somniq-remote.server.conf.template. This preserves the one-time browser
# WebSocket ticket carried in Sec-WebSocket-Protocol; do not strip that header.
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $somniq_connection_upgrade;
proxy_cache_bypass $http_upgrade;
