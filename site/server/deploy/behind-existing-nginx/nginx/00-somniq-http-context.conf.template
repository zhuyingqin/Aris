# Include this file once from Nginx's `http { ... }` context, not from a
# `server { ... }` block. It is for a containerized Nginx that is attached to
# the Docker network named SOMNIQ_NGINX_EDGE_NETWORK.

# Preserve WebSocket upgrades for /v1/signal, /v1/relay and browser-facing
# ticket exchanges while keeping normal requests on a keep-alive connection.
map $http_upgrade $somniq_connection_upgrade {
    default upgrade;
    ''      close;
}

# First-use desktop enrollment is intentionally passwordless so a local QR can
# start a pairing ceremony. Bound only this public write endpoint by client
# address; authenticated control and long-lived WebSocket routes are separate.
limit_req_zone $binary_remote_addr zone=somniq_pairing_registration:10m rate=6r/m;

# Resolve the private Caddy alias dynamically, so a Caddy container
# replacement does not leave the outer edge pinned to its former IP. The
# owning Nginx `http {}` configuration must define Docker's resolver exactly
# once (for example, `resolver 127.0.0.11 ipv6=off valid=10s;`). Keeping it
# outside this reusable fragment avoids a duplicate-directive error in Nginx
# stacks, such as Overleaf Toolkit, that already provide it.
upstream somniq_remote_edge {
    zone somniq_remote_edge_dns 64k;
    server somniq-remote-edge:8080 resolve;
}

# The account backend, for the deployment where Nginx maps the website's API
# paths itself (see 10-/20-somniq-domain-*.server.conf.template). Nginx must
# share a Docker network with this container, or every account route answers
# 502 with "could not be resolved" in the error log.
upstream somniq_newapi_upstream {
    zone somniq_newapi_upstream_dns 64k;
    server new-api:3000 resolve;
}
