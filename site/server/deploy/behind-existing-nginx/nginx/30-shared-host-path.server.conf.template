# LEGACY CAPABILITY-ONLY TEMPLATE. The unified same-account flow requires a
# dedicated hostname so homepage, dashboard, remote PWA, and APIs share one
# origin. Do not use this template for account-connected deployments.
#
# Use this variant when the only controllable HTTPS hostname already serves
# another application. It keeps that application's root routes intact while
# exposing the SomniQ PWA at a dedicated path, e.g. `/somniq/`.
#
# Replace every <...> placeholder. The `sharelatex` upstream and fallback
# location below model the current Overleaf-toolkit edge; adapt that fallback
# only when the existing application uses another upstream.

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name <existing-hostnames>;

    ssl_certificate     <path-to-fullchain.pem>;
    ssl_certificate_key <path-to-privkey.pem>;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubdomains;";
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https: wss:; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests" always;
    server_tokens off;

    # Avoid an accidental duplicate PWA at the no-trailing-slash path, which
    # would give the service worker the wrong scope.
    location = <somniq-path> {
        access_log off;
        return 308 <somniq-path>/;
    }

    location = <somniq-path>/v1/pairings {
        access_log off;
        client_max_body_size 256k;
        limit_req zone=somniq_pairing_registration burst=8 nodelay;
        proxy_pass http://somniq_remote_edge/v1/pairings;
        include <path-to-proxy-headers.conf>;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location ^~ <somniq-path>/ {
        access_log off;
        client_max_body_size 256k;
        proxy_pass http://somniq_remote_edge/;
        include <path-to-proxy-headers.conf>;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Preserve the existing application at its normal root paths. This is
    # intentionally the same proxy behavior as the Overleaf-toolkit default.
    location / {
        proxy_pass http://sharelatex;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3m;
        proxy_send_timeout 3m;
    }
}
