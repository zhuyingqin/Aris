# Include inside a dedicated HTTPS preview virtual host with the built Site root.
# The account service must bind privately; configure its PUBLIC_URL to this host
# and HOME_PATH=/account.html. Supply actual approved agreement text and identity
# client settings before exposing it. This is not an existing-production overlay.
location ^~ /v2/account/ {
    proxy_pass http://127.0.0.1:8800;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control no-store always;
}
location = /oauth/oidc {
    proxy_pass http://127.0.0.1:8800;
    proxy_set_header Host $host;
    # Authorization codes and flow tokens must not appear in access logs.
    access_log off;
}
location = /v2/account/callback {
    proxy_pass http://127.0.0.1:8800;
    proxy_set_header Host $host;
    access_log off;
}
location = /v1/models {
    proxy_pass http://127.0.0.1:8800;
    proxy_set_header Host $host;
}
location = /v1/chat/completions {
    client_max_body_size 2m;
    proxy_pass http://127.0.0.1:8800;
    proxy_set_header Host $host;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 310s;
}
# No /api/* pass-through or New API management UI on this preview host.
